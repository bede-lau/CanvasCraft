{
  "name": "@canvascraft/branch-qa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Renders the branch template out-of-tree against every generated manifest and asserts no component overflows, truncates, breaks interactivity, or animates on load. Not shipped; never part of the Daytona snapshot.",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@canvascraft/orchestrator": "workspace:*",
    "@canvascraft/registry": "workspace:*",
    "@canvascraft/schema": "workspace:*"
  },
  "devDependencies": {
    "@base-ui/react": "1.7.0",
    "@types/node": "^24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "clsx": "2.1.1",
    "gsap": "3.15.0",
    "jsdom": "^27.0.0",
    "lenis": "1.3.26",
    "lucide-react": "1.35.0",
    "motion": "13.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
