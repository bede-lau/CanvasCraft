{
  "name": "@canvascraft/registry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./data/*": "./data/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "tsx src/cli/validate.ts",
    "thumbnails": "tsx src/cli/build-thumbnails.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@canvascraft/schema": "workspace:*",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "tsx": "^4.20.6",
    "vitest": "^4.1.11",
    "@types/node": "^24.10.1"
  }
}
