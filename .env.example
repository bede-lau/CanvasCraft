# =============================================================================
# CanvasCraft — orchestration credentials
# Copy to `.env` at the repo root. NEVER commit `.env`.
# Only the orchestrator (apps/orchestrator) reads these. The browser never does.
# =============================================================================

# ----- 1. AI generator (provider-neutral, OpenAI-compatible) -----------------
# Any endpoint that speaks the OpenAI /v1 API. Default target: OpenAI direct.
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
# Multimodal model used to read the canvas image + structured doc.
OPENAI_VISION_MODEL=gpt-5.6
# Cheaper/faster model for recommendations + patch instructions.
OPENAI_TEXT_MODEL=gpt-5.6-luna

# ----- 2. Daytona — parallel live-branch engine ------------------------------
# https://app.daytona.io  ->  Keys
DAYTONA_API_KEY=dtn_...
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us
# Registered name or id of the pre-baked snapshot created by `pnpm snapshot:build`.
DAYTONA_SNAPSHOT=canvascraft-vite-starter:0.1.0
# Fixed port every generated branch serves its built preview on.
DAYTONA_PREVIEW_PORT=4173
# Stop a sandbox after N minutes of inactivity (0 = never).
DAYTONA_AUTO_STOP_MINUTES=30

# ----- 3. Nosana — GPU visual component matcher ------------------------------
# URL of the deployed CLIP embedding job (from `nosana job post`).
NOSANA_ENDPOINT=
# Optional bearer token if you put one in front of the service.
NOSANA_API_KEY=

# ----- 4. Orchestrator runtime ----------------------------------------------
PORT=8787
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173
# Where canvas uploads + run artifacts are written (gitignored).
DATA_DIR=./.canvascraft
LOG_LEVEL=info
